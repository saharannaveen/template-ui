# Copy this file to gateway.env and fill in your SSO credentials.
# gateway.env is gitignored — never commit real secrets.

ENVIRONMENT=dev
DEV_AUTH_ENABLED=true
SESSION_SECRET=change-me-to-a-random-32-char-string
SESSION_MAX_AGE=7200
SESSION_IDLE_TIMEOUT=3600
VALKEY_URL=redis://valkey:6379/0
LOG_LEVEL=INFO
GATEWAY_UI_DIST_PATH=/app/dist

# SSO Configuration — get these from your OIDC provider admin
SSO_CLIENT_ID=your-client-id
SSO_CLIENT_SECRET=your-client-secret
SSO_CALLBACK_URL=http://localhost:3100/auth/callback/oidc
SSO_AUTHORIZATION_URL=https://your-sso-host/auth/realms/your-realm/protocol/openid-connect/auth
SSO_TOKEN_URL=https://your-sso-host/auth/realms/your-realm/protocol/openid-connect/token
SSO_INTROSPECTION_URL=https://your-sso-host/auth/realms/your-realm/protocol/openid-connect/token/introspect
SSO_USERINFO_URL=https://your-sso-host/auth/realms/your-realm/protocol/openid-connect/userinfo

# Disable extras for local testing
ENABLE_OTEL_METRICS=false
ENABLE_OTEL_TRACES=false
RATE_LIMIT_REQUESTS=10000
RATE_LIMIT_WINDOW_SECONDS=60
ENABLE_REGISTRY=false
ENABLE_RUNTIME=false
REGISTRY_URL=http://localhost:9999
AGENT_ENGINE_URL=http://localhost:9999
